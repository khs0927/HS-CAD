# HS-CAD free-only profile
# Copy to a local .env file only when needed. The default runtime requires no
# account, API key, cloud project, or paid service.

HSCAD_RUNTIME_PROFILE=free-local
HSCAD_WORKSPACE_ID=local-workstation
HSCAD_SUMMARY_BACKEND=local
HSCAD_ALLOW_PAID_SERVICES=0
HSCAD_ALLOW_NETWORK_MODELS=0
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# Optional free-tier Supabase summary control plane.
# Leave unset for a fully offline runtime. Never bundle a service-role key in
# an EXE or commit it to the repository.
# HSCAD_SUPABASE_URL=https://YOUR_FREE_PROJECT.supabase.co
# HSCAD_SUPABASE_SERVICE_ROLE_KEY=set-only-in-trusted-local-environment

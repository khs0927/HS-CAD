      "module": "src.workers.analysis_phase5_domain_rule_decision_bridge_worker",
      "callable": "run_worker",
      "status": "implemented",
      "description": "Review-only Phase 5 bridge from Phase 4 decision candidates to Domain Rule Decision input package.",
      "outputs": [
        "PHASE5_DOMAIN_DECISION_BRIDGE.json",
        "PHASE5_DOMAIN_DECISION_BRIDGE.md",
        "PHASE5_DOMAIN_RULE_INPUT_PACKAGE.json"
      ],
      "safety": {
        "source_mutation_allowed": false,
        "cad_execution_allowed": false,
        "zwcad_com_allowed": false,
        "sendcommand_allowed": false,
        "xicad_alias_execution_allowed": false,
        "execution_allowed": false,
        "domain_rule_review_only": true
      }
    },
    "analysis_phase6_domain_rule_workflow_adapter": {
      "module": "src.workers.analysis_phase6_domain_rule_workflow_adapter_worker",
      "callable": "run_worker",
      "status": "implemented",
      "description": "Review-only Phase 6 adapter from Phase 5 domain bridge to Domain Rule Decision Workflow input.",
      "outputs": [
        "PHASE6_DOMAIN_RULE_WORKFLOW_ADAPTER.json",
        "PHASE6_DOMAIN_RULE_WORKFLOW_ADAPTER.md",
        "DOMAIN_RULE_DECISION_INPUT_FROM_PHASE6.json"
      ],
      "safety": {
        "source_mutation_allowed": false,
        "cad_execution_allowed": false,
        "zwcad_com_allowed": false,
        "sendcommand_allowed": false,
        "xicad_alias_execution_allowed": false,
        "execution_allowed": false,
        "domain_rule_review_only": true,
        "command_plan_execution_allowed": false
      }
    },
    "analysis_phase7_9_review_pipeline_bundle": {
      "module": "src.workers.analysis_phase7_9_review_pipeline_bundle_worker",
      "callable": "run_worker",
      "status": "implemented",

# Optional stable label used in cloud run summaries. When omitted, HS-CAD
# hashes the local workspace path instead of uploading it.
HSCAD_WORKSPACE_ID=office-workstation-01

# Optional Supabase run-summary control plane.
# These variables are read only when `corpus-run complete --cloud-summary`
# is used. The service-role key must stay in a trusted runner environment and
# must never be embedded in the desktop executable or committed to Git.
HSCAD_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
HSCAD_SUPABASE_SERVICE_ROLE_KEY=replace-in-local-environment-only
HSCAD_SUPABASE_TIMEOUT=30
HSCAD_SUPABASE_BATCH_SIZE=200

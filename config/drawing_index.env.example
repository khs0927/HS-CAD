# HS-CAD drawing index settings
# The default runtime is free and local. It requires no account or API key.

# Optional stable label used in run summaries. When omitted, HS-CAD hashes the
# local workspace path instead of uploading it.
HSCAD_WORKSPACE_ID=office-workstation-01

# Default summary backend used by documentation and installers.
HSCAD_SUMMARY_BACKEND=local
HSCAD_ALLOW_PAID_SERVICES=0
HSCAD_ALLOW_EXTERNAL_SUMMARY=0

# Optional Supabase free-tier run-summary control plane.
# Set HSCAD_ALLOW_EXTERNAL_SUMMARY=1 only when intentionally using it, then
# select `corpus-run complete --summary-backend supabase`. Leave all variables
# unset for a fully offline configuration. The service-role key must stay in a
# trusted local/server environment and must never be embedded in the desktop EXE.
# HSCAD_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# HSCAD_SUPABASE_SERVICE_ROLE_KEY=replace-in-local-environment-only
HSCAD_SUPABASE_TIMEOUT=30
HSCAD_SUPABASE_BATCH_SIZE=200

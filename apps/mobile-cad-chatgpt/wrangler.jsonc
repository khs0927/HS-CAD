{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hscad-mobile-cad",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-13",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "run_worker_first": ["/mcp", "/mcp/*", "/health"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}

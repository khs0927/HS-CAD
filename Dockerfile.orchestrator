FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONUTF8=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /workspace
COPY . .

RUN python -m pip install --upgrade pip \
    && python -m pip install -e ".[dev]"

CMD ["sh", "-c", "python scripts/run_plugin_orchestrator.py --profile auto --output /tmp/hscad-orchestrator-result.json; status=$?; test -f /tmp/hscad-orchestrator-result.json && cat /tmp/hscad-orchestrator-result.json; exit $status"]
